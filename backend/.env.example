# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# Gemini API Key (Required for AI educational explanations)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Adaption Labs API Key (For synthetic benchmark dataset generation)
# Get your API key from Adaption Labs: https://adaptionlabs.ai/app/settings?tab=api_keys
# Format: pt_live_...
ADAPTION_API_KEY=your_adaption_api_key_here

# MongoDB Atlas Connection String
# Local fallback: mongodb://127.0.0.1:27017/healthlens
# Atlas format: mongodb+srv://<user>:<password>@cluster.mongodb.net/healthlens
MONGODB_URI=mongodb://127.0.0.1:27017/healthlens

# JWT Secret Key for Session Authentication
JWT_SECRET=your_jwt_secret_key_here
